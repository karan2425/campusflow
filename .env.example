# ---------------------------------------------------------------------------
# CampusFlow — Docker Compose / root environment
# Copy to `.env` before running `docker compose up`.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
POSTGRES_USER=campusflow
POSTGRES_PASSWORD=campusflow
POSTGRES_DB=campusflow

# --- API -------------------------------------------------------------------
# Change this in any deployment that is reachable from the internet.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Password given to every seeded demo account.
SEED_DEFAULT_PASSWORD=Password@123

# Comma-separated list of browser origins allowed to call the API directly.
# (The Next.js app proxies through /api/backend, so this is only needed if you
#  call the API from a separate origin.)
CORS_ORIGIN=http://localhost:3000

# --- AI service ------------------------------------------------------------
# Optional. Without a key the AI service runs its deterministic local fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# --- Web -------------------------------------------------------------------
# Origin the Next.js server proxies /api/backend/* to. Inside Compose this is
# the service name, not localhost.
API_ORIGIN=http://api:4000
