# --- Database ---------------------------------------------------------------
# Local docker: docker compose up -d postgres
DATABASE_URL="postgresql://campusflow:campusflow@localhost:5432/campusflow?schema=public"

# --- Auth -------------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# --- AI microservice (FastAPI) ---------------------------------------------
AI_SERVICE_URL="http://127.0.0.1:8000"
AI_SERVICE_TIMEOUT_MS=20000

# --- Seed -------------------------------------------------------------------
SEED_DEFAULT_PASSWORD="Password@123"
