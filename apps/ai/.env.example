# --- Google Gemini ----------------------------------------------------------
# Get a key at https://aistudio.google.com/app/apikey
# The service works WITHOUT a key using deterministic local fallbacks,
# it just loses natural-language generation quality.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_EMBED_MODEL="text-embedding-004"

# --- Service ----------------------------------------------------------------
PORT=8000
CORS_ORIGINS="http://localhost:3000,http://localhost:4000"

# --- Retrieval --------------------------------------------------------------
EMBEDDING_DIM=512
FAISS_INDEX_PATH="data/faiss/students.index"
